# Copy to .env on the staging server and fill in the real secrets.
PORT=5004
NODE_ENV=production

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

MONGODB_URI=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@innoventies.com

# Public origins that are allowed to call this API (comma separated, no trailing slash).
FRONTEND_URL=https://dev.innoventies.com
# The admin dashboard is served at /admin on this same origin, so it needs no extra entry.
CORS_ORIGIN=https://dev.innoventies.com
LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
BCRYPT_SALT_ROUNDS=12

# Razorpay (use test keys on staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
COD_ENABLED=true
