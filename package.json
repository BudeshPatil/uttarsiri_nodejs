{
  "name": "uttarsiri-nodejs",
  "version": "2.1.0",
  "description": "Uttar Siri grocery platform backend — MongoDB powered API (auth, CMS, catalogue, inventory, cart, checkout, orders)",
  "license": "ISC",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/i18n.util.test.js tests/pricing.util.test.js tests/payment.signature.test.js",
    "test:integration": "node --test tests/commerce.integration.test.js tests/checkout.integration.test.js tests/vendor.integration.test.js"
  },
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.0",
    "razorpay": "^2.9.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  }
}
